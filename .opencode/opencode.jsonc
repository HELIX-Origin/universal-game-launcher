{
  "$schema": "https://opencode.ai/config.json",

  // ── Universal Game Launcher project-local OpenCode config ────────────────
  // Inherits and extends the workspace-root `.opencode/opencode.jsonc`.
  // Project-local rules win on project-internal conventions; workspace-root
  // org-wide invariants (git safety, SemVer, zero-warning, licensing) always win.

  "instructions": [
    "AGENTS.md",
    "../../AGENTS.md"
  ],

  "permissions": [
    { "action": "read",               "resource": "*", "effect": "allow" },
    { "action": "edit",               "resource": "*", "effect": "allow" },
    { "action": "glob",               "resource": "*", "effect": "allow" },
    { "action": "grep",               "resource": "*", "effect": "allow" },
    { "action": "webfetch",           "resource": "*", "effect": "allow" },
    { "action": "websearch",          "resource": "*", "effect": "allow" },
    { "action": "skill",              "resource": "*", "effect": "allow" },
    { "action": "subagent",           "resource": "*", "effect": "allow" },
    { "action": "question",           "resource": "*", "effect": "allow" },

    // Read-only git inspection.
    { "action": "shell", "resource": "git status *",   "effect": "allow" },
    { "action": "shell", "resource": "git diff *",     "effect": "allow" },
    { "action": "shell", "resource": "git log *",      "effect": "allow" },
    { "action": "shell", "resource": "git show *",     "effect": "allow" },
    { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
    { "action": "shell", "resource": "git remote -v",  "effect": "allow" },

    // Project verification commands (zero-warning gate).
    { "action": "shell", "resource": "cargo check *",     "effect": "allow" },
    { "action": "shell", "resource": "cargo test *",      "effect": "allow" },
    { "action": "shell", "resource": "cargo clippy *",    "effect": "allow" },
    { "action": "shell", "resource": "cargo build *",     "effect": "allow" },
    { "action": "shell", "resource": "npm run check *",   "effect": "allow" },
    { "action": "shell", "resource": "npm run build *",   "effect": "allow" },
    { "action": "shell", "resource": "npm test *",        "effect": "allow" },
    { "action": "shell", "resource": "npx svelte-check *","effect": "allow" },
    { "action": "shell", "resource": "node scripts/* *",  "effect": "allow" },

    // Everything else prompts before running.
    { "action": "shell", "resource": "*", "effect": "ask" },

    // Gated: repository-mutating git (workspace invariant #1).
    { "action": "shell", "resource": "git add *",      "effect": "ask" },
    { "action": "shell", "resource": "git commit *",   "effect": "ask" },
    { "action": "shell", "resource": "git push *",     "effect": "ask" },
    { "action": "shell", "resource": "git pull *",     "effect": "ask" },
    { "action": "shell", "resource": "git fetch *",    "effect": "ask" },
    { "action": "shell", "resource": "git merge *",    "effect": "ask" },
    { "action": "shell", "resource": "git rebase *",   "effect": "ask" },
    { "action": "shell", "resource": "git reset *",    "effect": "ask" },
    { "action": "shell", "resource": "git tag *",      "effect": "ask" },
    { "action": "shell", "resource": "git checkout *", "effect": "ask" },
    { "action": "shell", "resource": "git switch *",   "effect": "ask" },
    { "action": "shell", "resource": "git clean *",    "effect": "ask" },
    { "action": "shell", "resource": "rm *",           "effect": "ask" },
    { "action": "shell", "resource": "sudo *",         "effect": "ask" }
  ],

  "formatter": true,
  "compaction": { "auto": true }
}
